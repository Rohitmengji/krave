{
  "name": "krave",
  "version": "1.0.0",
  "private": true,
  "description": "Krave — independent food delivery, dining and offline dine-in billing prototype informed by public website observations. No Zomato APK or server source was analyzed.",
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "next start --port 3005",
    "test": "vitest run",
    "test:db": "node --env-file=.env.local ./node_modules/.bin/vitest run src/tests/pgLayer.test.ts",
    "test:e2e": "playwright test",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs",
    "db:setup:test": "node --env-file=.env.local scripts/db-setup.mjs --test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
