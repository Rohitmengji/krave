# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Neon connection string, from the Neon console: Dashboard > Connect.
# Use the POOLED connection (host contains "-pooler") for the app.
# Keep ?sslmode=require — Neon refuses unencrypted connections.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# The DIRECT connection (same host without "-pooler"). Used only by scripts/db-setup.mjs for
# schema changes, because the pooler runs in transaction mode. Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Local Postgres or a disposable Neon branch for tests. Never point this at a database
# you need: the suite drops and recreates every table.
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/krave_test"

# HMAC key for checkout price locks. Required in production; without it, locks are
# disabled and checkout falls back to live pricing.
KRAVE_QUOTE_SECRET="change-me-to-a-long-random-string"

# Optional direct URL for the test branch, used by `npm run db:setup:test`.
TEST_DATABASE_URL_UNPOOLED=""

# Comma-separated emails treated as staff at every outlet. How the first operator is made.
# These accounts may also create and manage restaurants at /owner.
KRAVE_STAFF_EMAILS=""

# Extra comma-separated emails allowed to create restaurants at /owner without POS staff access.
KRAVE_RESTAURANT_ADMIN_EMAILS=""

# Set to 1 to treat EVERY signed-in account as staff. Demo convenience only.
KRAVE_OPEN_STAFF=""

# Mail server for password reset links. Leave SMTP_HOST empty to turn email off: production
# then refuses reset requests, and development writes the link to the server log instead.
# Port 587 must offer STARTTLS; 465 is TLS from the start. For Gmail use an app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Optional sender. Defaults to "KRAVE <SMTP_USER>".
EMAIL_FROM=""

# The site address used in emailed links. Required in production unless on Vercel, where
# the project's production domain is used.
KRAVE_PUBLIC_URL=""

# Menu photo/PDF extraction at /owner. Without a key, uploads still work but extraction is
# refused with a clear message, and owners add dishes by hand. Each owner may extract
# 10 pages per 15 minutes.
OPENAI_API_KEY=""
# Optional. Defaults to gpt-4o-mini.
OPENAI_MENU_MODEL=""

# Private S3-compatible storage for menu documents and dish photos (Neon Object Storage,
# AWS S3, Cloudflare R2...). All four AWS_* values are required; without them uploads are
# disabled and the owner dashboard says so. Files are private and served through signed,
# owner-checked routes. Use a separate bucket per environment.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
# Optional. Defaults to krave-assets.
KRAVE_STORAGE_BUCKET=""
